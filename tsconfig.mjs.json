{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./x/mjs",
    "jsx": "react-jsx",
    "noEmit": false,
    "jsxImportSource": null
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/stories/**",
    "src/**/__tests__/**",
    "src/**/*.spec.*"
  ]
}