{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2019",
    "lib": [
      "ES2022"
    ],
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./x/cjs",
    "noEmit": false,
    "jsx": "react-jsx",
    "jsxImportSource": null
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/stories/**",
    "src/**/__tests__/**",
    "src/**/*.spec.*"
  ]
}